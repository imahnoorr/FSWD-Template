@page "/"
@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using Models
@using BusinessLogicLayer
@using DataAccessLayer
@inject IProductService ps

<PageTitle>Product Information</PageTitle>

<h1>Product Information</h1>

<div class="mb-3">
    <button class="btn btn-secondary"
            @onclick="TestDatabaseAsync"
            disabled="@isBusy">
        Test Database Connection
    </button>

    <button class="btn btn-primary ms-2"
            @onclick="LoadProductsAsync"
            disabled="@isBusy">
        Refresh Products
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p>@statusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error:</strong>
        <pre style="white-space: pre-wrap;">@errorMessage</pre>
    </div>
}

<hr />

<h3>@(isEditing ? "Update Product" : "Add Product")</h3>

<div class="mb-2">
    <label class="form-label">Product ID</label>
    <input class="form-control"
           type="number"
           @bind="editProduct.PId"
           disabled="@isEditing" />
</div>

<div class="mb-2">
    <label class="form-label">Product Name</label>
    <input class="form-control"
           @bind="editProduct.ProductName" />
</div>

<div class="mb-3">
    <label class="form-label">Price</label>
    <input class="form-control"
           type="number"
           @bind="editProduct.Price" />
</div>

<button class="btn btn-success"
        @onclick="SaveProductAsync"
        disabled="@isBusy">
    @(isEditing ? "Update Product" : "Add Product")
</button>

@if (isEditing)
{
    <button class="btn btn-secondary ms-2"
            @onclick="CancelEdit"
            disabled="@isBusy">
        Cancel
    </button>
}

<hr />

<h3>Products</h3>

@if (isLoading)
{
    <p>Loading products from Supabase...</p>
}
else if (Products.Count == 0 && string.IsNullOrWhiteSpace(errorMessage))
{
    <p>No products found.</p>
}
else if (Products.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Product ID</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Products)
                {
                    <tr @key="product.PId">
                        <td>@product.PId</td>
                        <td>@product.ProductName</td>
                        <td>@product.Price</td>
                        <td>
                            <button class="btn btn-warning btn-sm"
                                    @onclick="() => StartEdit(product)"
                                    disabled="@isBusy">
                                Edit
                            </button>

                            <button class="btn btn-danger btn-sm ms-1"
                                    @onclick="() => DeleteProductAsync(product.PId)"
                                    disabled="@isBusy">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ProductModel> Products = new();

    private ProductModel editProduct = new()
    {
        ProductName = "",
        Price = 0
    };

    private bool isLoading = true;
    private bool isBusy = false;
    private bool isEditing = false;

    private string statusMessage = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        isLoading = true;
        isBusy = true;
        errorMessage = "";
        statusMessage = "";

        try
        {
            Products = await Task.Run(() => ps.GetAllData());
            statusMessage = $"Loaded {Products.Count} product(s).";
        }
        catch (Exception ex)
        {
            errorMessage = ex.ToString();
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
            isBusy = false;
        }
    }

    private async Task TestDatabaseAsync()
    {
        isBusy = true;
        errorMessage = "";
        statusMessage = "Testing Supabase connection...";

        try
        {
            int result = await Task.Run(() => CRUD.TestConnection());

            statusMessage = result == 1
                ? "Database connection successful!"
                : $"Unexpected database test result: {result}";
        }
        catch (Exception ex)
        {
            statusMessage = "Database connection failed.";
            errorMessage = ex.ToString();
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void StartEdit(ProductModel product)
    {
        editProduct = new ProductModel
        {
            PId = product.PId,
            ProductName = product.ProductName,
            Price = product.Price
        };

        isEditing = true;
        errorMessage = "";
        statusMessage = "";
    }

    private void CancelEdit()
    {
        isEditing = false;

        editProduct = new ProductModel
        {
            ProductName = "",
            Price = 0
        };

        errorMessage = "";
        statusMessage = "";
    }

    private async Task SaveProductAsync()
    {
        if (editProduct.PId <= 0)
        {
            errorMessage = "Product ID must be greater than zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editProduct.ProductName))
        {
            errorMessage = "Please enter a product name.";
            return;
        }

        isBusy = true;
        errorMessage = "";
        statusMessage = "";

        try
        {
            int rowsAffected;

            if (isEditing)
            {
                rowsAffected = await Task.Run(
                    () => ps.UpdateData(editProduct));

                statusMessage = rowsAffected > 0
                    ? "Product updated successfully."
                    : "No product was updated. Check the product ID.";
            }
            else
            {
                rowsAffected = await Task.Run(
                    () => ps.InsertData(editProduct));

                statusMessage = rowsAffected > 0
                    ? "Product added successfully."
                    : "No product was added.";
            }

            if (rowsAffected > 0)
            {
                isEditing = false;

                editProduct = new ProductModel
                {
                    ProductName = "",
                    Price = 0
                };

                Products = await Task.Run(() => ps.GetAllData());
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.ToString();
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteProductAsync(int id)
    {
        isBusy = true;
        errorMessage = "";
        statusMessage = "";

        try
        {
            int rowsAffected = await Task.Run(
                () => ps.DeleteData(id));

            if (rowsAffected > 0)
            {
                statusMessage = "Product deleted successfully.";
                Products = await Task.Run(() => ps.GetAllData());

                if (isEditing && editProduct.PId == id)
                {
                    CancelEdit();
                }
            }
            else
            {
                statusMessage = "No product was deleted.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.ToString();
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isBusy = false;
        }
    }
}
